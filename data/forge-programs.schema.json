{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speedandform.com/schemas/forge-programs.schema.json",
  "title": "Forge Programs",
  "description": "Canonical Forge program content shared across products.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "updatedAt",
    "programs"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "programs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/program"
      }
    }
  },
  "$defs": {
    "set": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reps": {
          "type": "integer",
          "minimum": 1
        },
        "seconds": {
          "type": "integer",
          "minimum": 1
        },
        "targetWeightPounds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "oneOf": [
        {
          "required": [
            "reps"
          ]
        },
        {
          "required": [
            "seconds"
          ]
        }
      ]
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "movementId",
        "name",
        "loadType",
        "sets"
      ],
      "properties": {
        "movementId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "loadType": {
          "type": "string",
          "enum": [
            "weighted",
            "bodyweight",
            "time"
          ]
        },
        "restSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "equipment": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cue": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "sets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/set"
          }
        }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dayIndex",
        "sessionName",
        "estimatedMinutes",
        "equipment",
        "exercises"
      ],
      "properties": {
        "dayIndex": {
          "type": "integer",
          "minimum": 0
        },
        "sessionName": {
          "type": "string",
          "minLength": 1
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "equipment": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exercises": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exercise"
          }
        }
      }
    },
    "week": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weekNumber",
        "days"
      ],
      "properties": {
        "weekNumber": {
          "type": "integer",
          "minimum": 1
        },
        "days": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/day"
          }
        }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "shortDescription",
        "audience",
        "status",
        "weeks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+_v[0-9]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "shortDescription": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "placeholder",
            "authored"
          ]
        },
        "weeks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/week"
          }
        }
      }
    }
  }
}
